# API service configuration - env: {{ env_name | default('dev') }}
# Generated by config-template-engine
service:
  name: {{ app_name | default('api-service') }}
  version: {{ app_version | default('1.0.0') }}
  env: {{ env_name | default('dev') }}
  host: {{ host | default('0.0.0.0') }}
  port: {{ port | default(8000) }}
  workers: {{ workers | default(1 if env_name | default('dev') == 'dev' else 4) }}
  debug: {{ debug | default(env_name | default('dev') == 'dev') | to_json }}
  reload: {{ reload | default(env_name | default('dev') == 'dev') | to_json }}

http:
  base_path: {{ base_path | default('/api/v1') }}
  request_timeout: {{ request_timeout | default(30) }}
  max_request_size: {{ max_request_size | default('10MB') }}
  cors:
    enabled: {{ cors_enabled | default(true) | to_json }}
    origins:
{% for origin in cors_origins | default(['*'] if env_name | default('dev') != 'prod' else []) %}
      - "{{ origin }}"
{% else %}
      - "https://app.example.com"
{% endfor %}
    methods:
{% for m in cors_methods | default(['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']) %}
      - {{ m }}
{% endfor %}
    allow_credentials: {{ cors_credentials | default(true) | to_json }}

auth:
  enabled: {{ auth_enabled | default(true) | to_json }}
  type: {{ auth_type | default('jwt') }}
{% if auth_type | default('jwt') == 'jwt' %}
  jwt:
    secret: "{{ jwt_secret | default('change-me-in-production') }}"
    algorithm: {{ jwt_algorithm | default('HS256') }}
    access_token_ttl: {{ access_token_ttl | default(3600) }}
    refresh_token_ttl: {{ refresh_token_ttl | default(86400) }}
{% elif auth_type | default('jwt') == 'api_key' %}
  api_key:
    header: {{ api_key_header | default('X-API-Key') }}
    keys:
{% for k in api_keys | default(['dev-key']) %}
      - "{{ k }}"
{% endfor %}
{% endif %}

rate_limit:
  enabled: {{ rate_limit_enabled | default(env_name | default('dev') == 'prod') | to_json }}
  strategy: {{ rate_limit_strategy | default('fixed-window') }}
  requests_per_minute: {{ rpm | default(60) }}
  burst: {{ rate_burst | default(20) }}

{% if endpoints is defined and endpoints %}
endpoints:
{% for ep in endpoints %}
  - path: {{ ep.path }}
    methods:
{% for m in ep.methods | default(['GET']) %}
      - {{ m }}
{% endfor %}
    auth_required: {{ ep.auth_required | default(true) | to_json }}
{% if ep.rate_limit is defined %}
    rate_limit: {{ ep.rate_limit }}
{% endif %}
{% if ep.description is defined %}
    description: "{{ ep.description }}"
{% endif %}
{% endfor %}
{% endif %}

observability:
  metrics:
    enabled: {{ metrics_enabled | default(true) | to_json }}
    path: {{ metrics_path | default('/metrics') }}
  healthcheck:
    enabled: true
    path: {{ health_path | default('/health') }}
  tracing:
    enabled: {{ tracing_enabled | default(false) | to_json }}
{% if tracing_enabled | default(false) %}
    exporter: {{ tracing_exporter | default('otlp') }}
    endpoint: {{ tracing_endpoint | default('http://localhost:4317') }}
{% endif %}

logging:
  level: {{ log_level | default('INFO' if env_name | default('dev') != 'dev' else 'DEBUG') | upper }}
  json: {{ json_logs | default(env_name | default('dev') == 'prod') | to_json }}