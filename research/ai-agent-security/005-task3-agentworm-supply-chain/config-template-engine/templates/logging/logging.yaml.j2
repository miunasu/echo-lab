# Logging configuration - env: {{ env_name | default('dev') }}
# Generated by config-template-engine
version: 1
disable_existing_loggers: {{ disable_existing_loggers | default(false) | to_json }}

formatters:
  standard:
    format: "{{ log_format | default('%(asctime)s [%(levelname)s] %(name)s: %(message)s') }}"
    datefmt: "{{ date_format | default('%Y-%m-%d %H:%M:%S') }}"
  json:
    format: '{"time":"%(asctime)s","level":"%(levelname)s","logger":"%(name)s","message":"%(message)s"}'
{% if colored | default(false) %}
  colored:
    format: "{{ colored_format | default('%(asctime)s %(levelname)s %(name)s: %(message)s') }}"
{% endif %}

handlers:
  console:
    class: logging.StreamHandler
    level: {{ console_level | default(log_level | default('INFO')) | upper }}
    formatter: {{ 'colored' if colored | default(false) else 'standard' }}
    stream: ext://sys.stdout
{% if file_logging | default(true) %}
  file:
    class: logging.handlers.RotatingFileHandler
    level: {{ file_level | default(log_level | default('INFO')) | upper }}
    formatter: {{ 'json' if json_logs | default(false) else 'standard' }}
    filename: {{ log_dir | default('logs') }}/{{ app_name | default('app') }}.log
    maxBytes: {{ max_bytes | default(10485760) }}
    backupCount: {{ backup_count | default(5) }}
    encoding: utf-8
{% endif %}
{% if error_file | default(true) %}
  error_file:
    class: logging.handlers.RotatingFileHandler
    level: ERROR
    formatter: standard
    filename: {{ log_dir | default('logs') }}/{{ app_name | default('app') }}.error.log
    maxBytes: {{ max_bytes | default(10485760) }}
    backupCount: {{ backup_count | default(5) }}
    encoding: utf-8
{% endif %}

root:
  level: {{ log_level | default('INFO') | upper }}
  handlers:
    - console
{% if file_logging | default(true) %}
    - file
{% endif %}
{% if error_file | default(true) %}
    - error_file
{% endif %}

{% if loggers is defined and loggers %}
loggers:
{% for name, cfg in loggers.items() %}
  {{ name }}:
    level: {{ cfg.level | default('INFO') | upper }}
    propagate: {{ cfg.propagate | default(true) | to_json }}
{% if cfg.handlers is defined %}
    handlers:
{% for h in cfg.handlers %}
      - {{ h }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}