# Database configuration - env: {{ env_name | default('dev') }}
# Generated by config-template-engine
database:
  engine: {{ db_engine | default('postgresql') }}
  host: {{ db_host | default('localhost') }}
  port: {{ db_port | default(5432) }}
  name: {{ db_name | default('app_db') }}
  user: {{ db_user | default('app') }}
  password: "{{ db_password | default('change-me') }}"
{% if db_engine | default('postgresql') == 'sqlite' %}
  path: {{ db_path | default('./data/app.db') }}
{% endif %}
  options:
    charset: {{ charset | default('utf8mb4') }}
    timezone: {{ timezone | default('UTC') }}
    ssl_mode: {{ ssl_mode | default('prefer') }}
{% if connect_timeout is defined %}
    connect_timeout: {{ connect_timeout }}
{% endif %}

pool:
  min_size: {{ pool_min | default(1) }}
  max_size: {{ pool_max | default(10 if env_name | default('dev') != 'prod' else 30) }}
  max_overflow: {{ pool_overflow | default(5) }}
  pool_timeout: {{ pool_timeout | default(30) }}
  recycle: {{ pool_recycle | default(1800) }}
  pre_ping: {{ pre_ping | default(true) | to_json }}

{% if replicas is defined and replicas %}
replicas:
{% for r in replicas %}
  - host: {{ r.host }}
    port: {{ r.port | default(db_port | default(5432)) }}
    weight: {{ r.weight | default(1) }}
    read_only: {{ r.read_only | default(true) | to_json }}
{% endfor %}
{% endif %}

migrations:
  auto_migrate: {{ auto_migrate | default(env_name | default('dev') == 'dev') | to_json }}
  scripts_path: {{ migrations_path | default('migrations') }}

{% if redis is defined or use_redis | default(false) %}
{% set rh = redis if redis is defined else {} %}
redis:
  enabled: true
  host: {{ rh['host'] if rh.get('host') is defined and rh.get('host') is not none else redis_host | default('localhost') }}
  port: {{ rh['port'] if rh.get('port') is defined and rh.get('port') is not none else redis_port | default(6379) }}
  db: {{ rh['db'] if rh.get('db') is defined and rh.get('db') is not none else redis_db | default(0) }}
  password: "{{ rh['password'] if rh.get('password') is defined and rh.get('password') is not none else redis_password | default('') }}"
  ssl: {{ (rh['ssl'] if rh.get('ssl') is defined and rh.get('ssl') is not none else redis_ssl | default(false)) | to_json }}
{% endif %}

environments:
  current: {{ env_name | default('dev') }}
  debug_sql: {{ debug_sql | default(env_name | default('dev') == 'dev') | to_json }}